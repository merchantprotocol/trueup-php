{
    "name": "trueup/trueup",
    "description": "Official TrueUp API client for PHP: reconcile ledgers, statements and bank feeds",
    "type": "library",
    "license": "MIT",
    "keywords": ["trueup", "reconciliation", "accounting", "bank-reconciliation", "ledger", "api-client"],
    "homepage": "https://trueup-cloud.merchantprotocol.workers.dev/docs#sdks",
    "authors": [{ "name": "Merchant Protocol" }],
    "support": {
        "issues": "https://github.com/merchantprotocol/trueup-php/issues",
        "source": "https://github.com/merchantprotocol/trueup-php"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "TrueUp\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "TrueUp\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit tests"
    }
}
